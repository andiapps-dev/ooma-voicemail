# Copy to .env and fill in. Never commit the real .env file.

# --- Ooma credentials (required) ---------------------------------------
# The login page for your Ooma portal. The host is reused for every other
# request the checker makes (the voicemail page, the download-link API),
# so this is the only place a different Ooma domain needs to be set.
OOMA_URL=https://my.ooma.com/login
OOMA_USER=
OOMA_PASS=

# --- Notifications (optional) -------------------------------------------
# One or more Apprise URLs (https://github.com/caronc/apprise/wiki),
# comma-separated — e.g. mailto://user:pass@smtp.example.com or
# discord://webhook_id/webhook_token. Delivered in-process via
# github.com/unraid/apprise-go, no separate service required. If left
# unset, voicemails are still downloaded — you just won't be notified.
APPRISE_URLS=

# --- Scheduling -----------------------------------------------------------
# How often to check for new voicemails. Accepts any Go duration
# (e.g. 5m, 15m, 1h). Defaults to 15m if unset.
CHECK_INTERVAL=15m
